{
  "name": "wrench",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "cd apps/api && go run ./cmd/api",
    "migrate": "apps/api/scripts/migrate.sh",
    "migrate:up": "apps/api/scripts/migrate.sh up",
    "migrate:down": "apps/api/scripts/migrate.sh down 1",
    "migrate:status": "apps/api/scripts/migrate.sh version",
    "migrate:create": "apps/api/scripts/migrate.sh create",
    "migrate:force": "apps/api/scripts/migrate.sh force",
    "prepare": "husky install",
    "lint": "npm --prefix apps/web run lint && cd apps/api && go vet ./...",
    "test": "npm --prefix apps/web run test && cd apps/api && go test ./..."
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.0.0"
  }
}
