FROM kong:3.6-ubuntu

# gettext-base provides envsubst, which renders kong.yaml at boot — see
# docker-entrypoint.sh. curl and iproute2 are for debugging from inside the
# running container (railway ssh): curl to test routes over both IPv4 and
# IPv6, ss to confirm what Kong is actually listening on.
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gettext-base \
        curl \
        ca-certificates \
        iproute2 \
    && rm -rf /var/lib/apt/lists/*

COPY kong.yaml /kong/declarative/kong.yaml.template
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENV KONG_DATABASE=off
# Rendered at boot, so it must live somewhere the kong user can write.
ENV KONG_DECLARATIVE_CONFIG=/tmp/kong.yaml
ENV KONG_ADMIN_LISTEN=0.0.0.0:8001
ENV KONG_LOG_LEVEL=info
ENV KONG_PROXY_ACCESS_LOG=/dev/stdout
ENV KONG_ADMIN_ACCESS_LOG=/dev/stdout
ENV KONG_PROXY_ERROR_LOG=/dev/stderr
ENV KONG_ADMIN_ERROR_LOG=/dev/stderr
ENV KONG_NGINX_WORKER_PROCESSES=2

# Kong sits behind Railway's edge, which terminates TLS and forwards plaintext.
# Without trusting that hop, Kong sees every request as http from the edge's
# own address and ignores the X-Forwarded-* headers it sets.
ENV KONG_TRUSTED_IPS=0.0.0.0/0,::/0
# X-Forwarded-For, not X-Forwarded-Proto: real_ip_header names the header
# carrying the client IP. Pointed at a protocol header it yields no address,
# so Kong falls back to the socket peer — Railway's edge — and every request
# looks like it came from one client.
ENV KONG_REAL_IP_HEADER=X-Forwarded-For
# off = take the LAST entry in X-Forwarded-For, the one Railway's edge appends
# and a client cannot forge. With trusted_ips=0.0.0.0/0, `on` would walk past
# every trusted hop to the leftmost, client-supplied value — making per-IP
# rate limits bypassable by sending your own X-Forwarded-For.
ENV KONG_REAL_IP_RECURSIVE=off

USER kong

EXPOSE 8000 8001

CMD ["docker-entrypoint.sh"]
