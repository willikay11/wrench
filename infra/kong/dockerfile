FROM kong:3.6-ubuntu

# gettext-base provides envsubst, which renders kong.yaml at boot — see
# docker-entrypoint.sh. curl and iproute2 are for debugging from inside the
# running container (railway ssh): curl to test routes over both IPv4 and
# IPv6, ss to confirm what Kong is actually listening on.
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gettext-base \
        curl \
        ca-certificates \
        iproute2 \
    && rm -rf /var/lib/apt/lists/*

COPY kong.yaml /kong/declarative/kong.yaml.template
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENV KONG_DATABASE=off
# Rendered at boot, so it must live somewhere the kong user can write.
ENV KONG_DECLARATIVE_CONFIG=/tmp/kong.yaml
ENV KONG_ADMIN_LISTEN=0.0.0.0:8001
ENV KONG_LOG_LEVEL=info
ENV KONG_PROXY_ACCESS_LOG=/dev/stdout
ENV KONG_ADMIN_ACCESS_LOG=/dev/stdout
ENV KONG_PROXY_ERROR_LOG=/dev/stderr
ENV KONG_ADMIN_ERROR_LOG=/dev/stderr
ENV KONG_NGINX_WORKER_PROCESSES=2

USER kong

EXPOSE 8000 8001

CMD ["docker-entrypoint.sh"]
