# Base URL of the Wrench API, through Kong. No trailing slash.
#   local     http://localhost:8080
#   staging   https://staging.api.wrench.it.com
API_BASE_URL=https://staging.api.wrench.it.com

# Channel token for Kong's key-auth on /v1 (sent as X-Channel-Token).
#
# Server-only, deliberately NOT prefixed NEXT_PUBLIC_. Prefixing it would
# embed the credential in the client bundle for anyone to read. All calls
# that need it go through a Server Action so it never leaves the server.
CHANNEL_TOKEN=

# Google OAuth client, from the Google Cloud console. Both are server-only and
# deliberately NOT prefixed NEXT_PUBLIC_: the flow runs entirely in the route
# handlers under /api/auth/google, and prefixing the secret would publish it in
# the client bundle.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. The callback URL registered on the OAuth client. Leave blank and it
# is derived from the incoming request, which is what you want locally
#   http://localhost:3000/api/auth/google/callback
# Set it only where a proxy rewrites the host and that derivation is wrong.
GOOGLE_REDIRECT_URI=
